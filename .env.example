# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel.
# Nunca coloque valores reais neste arquivo.

# Banco Postgres (Neon). Na Vercel: Storage → Create Database → Neon.
# A Vercel cria esta variável sozinha; para rodar no computador, copie o valor de lá.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST.neon.tech/neondb?sslmode=require

# Login da área /admin
ADMIN_USERNAME=Admin
# Gere com: npm run hash-password   (a senha nunca fica salva em texto)
ADMIN_PASSWORD_HASH=scrypt:...:...

# Segredo aleatório com 32+ caracteres (assina a sessão do admin e anonimiza IPs).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Opcional: URL pública definitiva (ex.: https://aylasophia.vercel.app).
# Se vazio, usa src/config/event.ts e, na Vercel, o domínio de produção automático.
NEXT_PUBLIC_SITE_URL=
